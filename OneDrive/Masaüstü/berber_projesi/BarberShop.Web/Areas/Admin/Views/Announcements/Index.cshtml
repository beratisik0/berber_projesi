@model IEnumerable<Announcement>
@{
    ViewData["Title"] = "Duyuru Yönetimi";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="bi bi-megaphone me-2"></i>Duyuru Yönetimi</h1>
        <p class="text-muted mb-0">Müşterilere gösterilecek duyuruları yönetin.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Yeni Duyuru
    </a>
</div>

<div class="card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Başlık</th>
                        <th>İçerik</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var announcement in Model)
                    {
                        <tr>
                            <td><strong>@announcement.Title</strong></td>
                            <td class="text-muted">@(announcement.Content.Length > 50 ? announcement.Content.Substring(0, 50) + "..." : announcement.Content)</td>
                            <td>@announcement.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @if (announcement.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@announcement.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@announcement.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Bu duyuruyu silmek istediğinize emin misiniz?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-megaphone display-3 text-muted mb-3 d-block"></i>
            <p class="text-muted">Henüz duyuru eklenmemiş.</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>İlk Duyuruyu Ekle
            </a>
        </div>
    }
</div>
