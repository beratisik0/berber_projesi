@model IEnumerable<Appointment>
@{
    ViewData["Title"] = "Randevu Yönetimi";
    var barbers = ViewBag.Barbers as IEnumerable<Barber>;
    var selectedDate = (DateTime)ViewBag.SelectedDate;
    var selectedBarberId = ViewBag.SelectedBarberId as int?;
}

<div class="page-header">
    <h1><i class="bi bi-calendar-check me-2"></i>Randevu Yönetimi</h1>
    <p class="text-muted mb-0">Tüm randevuları görüntüleyin ve yönetin.</p>
</div>

<div class="card p-4 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Tarih</label>
            <input type="date" name="date" class="form-control" value="@selectedDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Berber</label>
            <select name="barberId" class="form-select">
                <option value="">Tümü</option>
                @if (barbers != null)
                {
                    @foreach (var barber in barbers)
                    {
                        <option value="@barber.Id" selected="@(selectedBarberId == barber.Id)">@barber.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search me-2"></i>Filtrele
            </button>
        </div>
    </form>
</div>

<div class="card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Saat</th>
                        <th>Müşteri</th>
                        <th>Telefon</th>
                        <th>Berber</th>
                        <th>Hizmet</th>
                        <th>Fiyat</th>
                        <th>Durum</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model)
                    {
                        var statusClass = appointment.Status switch
                        {
                            AppointmentStatus.Confirmed => "bg-success",
                            AppointmentStatus.Pending => "bg-warning",
                            AppointmentStatus.Completed => "bg-info",
                            AppointmentStatus.Cancelled => "bg-danger",
                            _ => "bg-secondary"
                        };
                        var statusText = appointment.Status switch
                        {
                            AppointmentStatus.Confirmed => "Onaylı",
                            AppointmentStatus.Pending => "Bekliyor",
                            AppointmentStatus.Completed => "Tamamlandı",
                            AppointmentStatus.Cancelled => "İptal",
                            _ => "-"
                        };
                        <tr>
                            <td>
                                <strong>@appointment.StartTime.ToString(@"hh\:mm")</strong>
                                <small class="text-muted d-block">@appointment.EndTime.ToString(@"hh\:mm")</small>
                            </td>
                            <td>@appointment.User?.FullName</td>
                            <td>@(appointment.User?.PhoneNumber ?? "-")</td>
                            <td>@appointment.Barber?.Name</td>
                            <td>@appointment.Service?.Name</td>
                            <td class="text-success fw-bold">@appointment.TotalPrice.ToString("C0")</td>
                            <td><span class="badge @statusClass">@statusText</span></td>
                            <td>
                                @if (appointment.Status != AppointmentStatus.Cancelled && appointment.Status != AppointmentStatus.Completed)
                                {
                                    <form asp-action="Cancel" method="post" class="d-inline" 
                                          onsubmit="return confirm('Bu randevuyu iptal etmek istiyor musunuz?');">
                                        <input type="hidden" name="id" value="@appointment.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-3 text-muted mb-3 d-block"></i>
            <p class="text-muted">Seçilen tarihte randevu bulunmuyor.</p>
        </div>
    }
</div>
