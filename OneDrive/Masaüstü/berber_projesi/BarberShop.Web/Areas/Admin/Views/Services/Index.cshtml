@model IEnumerable<Service>
@{
    ViewData["Title"] = "Hizmet Yönetimi";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="bi bi-list-check me-2"></i>Hizmet Yönetimi</h1>
        <p class="text-muted mb-0">Tüm hizmetleri görüntüleyin ve yönetin.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Yeni Hizmet
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Hizmet Adı</th>
                    <th>Açıklama</th>
                    <th>Fiyat</th>
                    <th>Süre</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var service in Model)
                {
                    <tr>
                        <td><strong>@service.Name</strong></td>
                        <td class="text-muted">@(service.Description ?? "-")</td>
                        <td><span class="text-success fw-bold">@service.Price.ToString("C0")</span></td>
                        <td>@service.DurationMinutes dk</td>
                        <td>
                            @if (service.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@service.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@service.Id" method="post" class="d-inline" 
                                  onsubmit="return confirm('Bu hizmeti silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
