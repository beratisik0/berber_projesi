@model IEnumerable<Appointment>
@{
    ViewData["Title"] = "Randevularım";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-calendar-check me-2"></i>Randevularım</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Yeni Randevu
        </a>
    </div>
    
    @if (!Model.Any())
    {
        <div class="card p-5 text-center">
            <i class="bi bi-calendar-x display-3 text-muted mb-3"></i>
            <h4>Henüz randevunuz bulunmuyor</h4>
            <p class="text-muted">Hemen ilk randevunuzu oluşturun!</p>
            <div>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Randevu Al
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var appointment in Model)
            {
                var statusClass = appointment.Status switch
                {
                    BarberShop.Core.Enums.AppointmentStatus.Confirmed => "bg-success",
                    BarberShop.Core.Enums.AppointmentStatus.Pending => "bg-warning",
                    BarberShop.Core.Enums.AppointmentStatus.Completed => "bg-info",
                    BarberShop.Core.Enums.AppointmentStatus.Cancelled => "bg-danger",
                    _ => "bg-secondary"
                };
                var statusText = appointment.Status switch
                {
                    BarberShop.Core.Enums.AppointmentStatus.Confirmed => "Onaylı",
                    BarberShop.Core.Enums.AppointmentStatus.Pending => "Bekliyor",
                    BarberShop.Core.Enums.AppointmentStatus.Completed => "Tamamlandı",
                    BarberShop.Core.Enums.AppointmentStatus.Cancelled => "İptal Edildi",
                    _ => "Bilinmiyor"
                };
                var isPast = appointment.AppointmentDate.Date < DateTime.Today || 
                            (appointment.AppointmentDate.Date == DateTime.Today && appointment.EndTime < DateTime.Now.TimeOfDay);
                
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 p-4 @(isPast ? "opacity-75" : "")">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge @statusClass">@statusText</span>
                            <span class="service-price">@appointment.TotalPrice.ToString("C0")</span>
                        </div>
                        <h5>@appointment.Service?.Name</h5>
                        <p class="text-muted mb-2">
                            <i class="bi bi-person me-1"></i>@appointment.Barber?.Name
                        </p>
                        <p class="text-muted mb-2">
                            <i class="bi bi-calendar3 me-1"></i>@appointment.AppointmentDate.ToString("dd MMMM yyyy, dddd")
                        </p>
                        <p class="text-muted mb-3">
                            <i class="bi bi-clock me-1"></i>@appointment.StartTime.ToString(@"hh\:mm") - @appointment.EndTime.ToString(@"hh\:mm")
                        </p>
                        @if (!string.IsNullOrEmpty(appointment.Notes))
                        {
                            <p class="small text-muted">
                                <i class="bi bi-sticky me-1"></i>@appointment.Notes
                            </p>
                        }
                        @if (appointment.Status != BarberShop.Core.Enums.AppointmentStatus.Cancelled && !isPast)
                        {
                            <form asp-action="Cancel" method="post" onsubmit="return confirm('Randevuyu iptal etmek istediğinize emin misiniz?');">
                                <input type="hidden" name="id" value="@appointment.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                    <i class="bi bi-x-circle me-1"></i>İptal Et
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
